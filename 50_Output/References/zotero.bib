@online{katsnelsonSelforganizedCriticalityNeural2021,
  title = {Self-Organized Criticality in Neural Networks},
  author = {Katsnelson, Mikhail I. and Vanchurin, Vitaly and Westerhout, Tom},
  date = {2021},
