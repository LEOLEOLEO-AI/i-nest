@article{stuijtMBrainEventDrivenFully2021,
  title = {{{μBrain}}: {{An Event-Driven}} and {{Fully Synthesizable Architecture}} for {{Spiking Neural Networks}}},
  author = {Stuijt, Jan and Sifalakis, Manolis and Yousefzadeh, Amirreza and Corradi, Federico},
  date = {2021},
