@article{thieleMultimodalBrainSignal2023,
  title = {Multimodal {{Brain Signal Complexity Predicts Human Intelligence}}},
  author = {Thiele, Jonas A. and Richter, Aylin and Hilger, Kirsten},
  date = {2023},
  journaltitle = {eneuro},
