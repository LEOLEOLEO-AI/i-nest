  title = {A {{Complex Systems Perspective}} on {{Neuroimaging Studies}} of {{Behavior}} and {{Its Disorders}}},
  author = {Turkheimer, Federico E. and Rosas, Fernando E. and Dipasquale, Ottavia and Martins, Daniel and Fagerholm, Erik D. and Expert, Paul and Váša, František and Lord, Louis-David and Leech, Robert},
  date = {2021},
