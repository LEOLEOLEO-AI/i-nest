@article{uenoVCSNVirtualCircuitSwitching2023,
  title = {{{VCSN}}: {{Virtual Circuit-Switching Network}} for {{Flexible}} and {{Simple-to-Operate Communication}} in {{HPC FPGA Cluster}}},
  author = {Ueno, Tomohiro and Sano, Kentaro},
  date = {2023},
  journaltitle = {ACM Transactions on Reconfigurable Technology and Systems},
