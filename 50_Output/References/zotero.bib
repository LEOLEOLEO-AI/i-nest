@article{kazemiPhaseSynchronizationMeasure2022,
  title = {Phase Synchronization and Measure of Criticality in a Network of Neural Mass Models},
  author = {Kazemi, Sheida and Jamali, Yousef},
  date = {2022},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci. Rep.},
  volume = {12},
