  title = {An Organized View of Reservoir Computing: A Perspective on Theory and Technology Development},
  shorttitle = {An Organized View of Reservoir Computing},
  author = {Abdi, Gisya and Mazur, Tomasz and Szaciłowski, Konrad},
  date = {2024-05-01},
  journaltitle = {Japanese Journal of Applied Physics},
  shortjournal = {Jpn. J. Appl. Phys.},
  volume = {63},
