  author = {Vogginger, Bernhard and Rostami, Amirhossein and Jain, Vaibhav and Arfa, Sirine and Hantsch, Andreas and Kappel, David and Schäfer, Michael and Faltings, Ulrike and Gonzalez, Hector A. and Liu, Chen and Mayr, Christian and Maaß, Wolfgang},
