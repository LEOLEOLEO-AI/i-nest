\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Experiment 5 (v14): SOC criticality validation summary. (A) Score distribution across 18 simulations (6 network$\times $rule combinations $\times $ 3 seeds): mean score 7.3/9, best 8/9. (B) Branching ratio $\kappa \in [0.92, 0.99]$ across all configurations---near-critical, consistent with in vivo recordings \citep  {priesemann2014}. (C) PSD slopes $\approx -1.3$, confirming 1/f dynamics. (D) Functional decoding accuracy $>0.45$ across all configurations.}}{14}{figure.caption.9}\protected@file@percent }
\newlabel{fig:exp5_summary}{{4}{14}{Experiment 5 (v14): SOC criticality validation summary. (A) Score distribution across 18 simulations (6 network$\times $rule combinations $\times $ 3 seeds): mean score 7.3/9, best 8/9. (B) Branching ratio $\kappa \in [0.92, 0.99]$ across all configurations---near-critical, consistent with in vivo recordings \citep {priesemann2014}. (C) PSD slopes $\approx -1.3$, confirming 1/f dynamics. (D) Functional decoding accuracy $>0.45$ across all configurations}{figure.caption.9}{}}
