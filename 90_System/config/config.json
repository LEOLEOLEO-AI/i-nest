{
    "version": "2.0.0",
    "project": "TCC x iNEST Research Platform",
    "description": "拓扑中心计算 × 智能涌现网络 — 双轨研究平台",

    "two_directions": {
        "TCC": {
            "name": "TCC — 拓扑中心计算 (Topological Center Computing)",
            "focus_areas": [
                "网络拓扑中心计算",
                "集体通信原语生成",
                "SDI化合键映射",
                "元拓扑优化",
                "物理拓扑映射 (PTM)"
            ],
            "tags": ["topology", "center-computing", "topology-first-architecture", "topology-reconfiguration", "collective-communication", "compute-in-transit", "meta-topology", "compound-bond", "topology-page", "SDI", "SDSoW"]
        },
        "iNEST": {
            "name": "iNEST — 智能涌现网络系统 (Intelligent Network Emergence Systems)",
            "focus_areas": [
                "自组织临界态涌现",
                "FEP-STDP协同机制",
                "超非线性增益",
                "类脑脉冲神经网络",
                "晶上智能互连架构"
            ],
            "tags": ["emergence", "physical-evolution-computing", "self-organization", "self-organized-criticality", "edge-of-chaos", "SDDE", "Lyapunov-spectrum", "time-scale-separation", "memristive-network", "neuromorphic", "spiking", "reservoir-computing", "higher-order-network", "causal-emergence"]
        }
    },

    "knowledge_graph": {
        "storage": "neo4j",
        "bidirectional_tags": true,
        "tag_system": {
            "direction": ["TCC", "iNEST"],
            "category": ["paper", "concept", "method", "experiment"],
            "priority": ["high", "medium", "low"],
            "status": ["new", "reviewed", "integrated", "obsolete"]
        },
        "node_types": ["paper", "author", "concept", "method", "dataset", "experiment", "insight", "patent"],
        "edge_types": ["cites", "builds_on", "contradicts", "related_to", "inspired_by", "applies_to"]
    },

    "dashboard": {
        "metrics": ["papers_scraped", "papers_imported", "insights_generated", "patents_drafting", "papers_writing", "code_commits", "sync_status", "agent_utilization", "experiment_results"],
        "update_interval": "hourly"
    },

    "paper_search": {
        "daily_cron": "09:00",
        "sources": [
            {"name": "arXiv", "categories": ["cs.AI", "cs.NE", "cs.MA", "cs.SI", "cs.NI", "cs.DC", "physics.soc-ph", "physics.comp-ph", "cond-mat.mes-hall"], "keywords": ["topology-centric computing", "topology reconfiguration", "meta-topology", "compute-in-transit", "stochastic delay differential equation", "memristive network", "physical reservoir computing", "higher-order network", "time-scale separation", "emergent computation"], "enabled": true},
            {"name": "IEEE Xplore", "keywords": ["reconfigurable interconnect", "NoC topology synthesis", "collective communication", "software-defined interconnect", "wafer-scale interconnect", "neuromorphic device physics"], "enabled": true},
            {"name": "ACM Digital Library", "keywords": ["topology-aware computing", "in-network computing", "route-as-transform", "higher-order network", "emergent computation"], "enabled": true},
            {"name": "Nature/Science", "keywords": ["physical evolution computing", "self-organized criticality", "edge of chaos", "complexity matching", "causal emergence", "collective dynamics"], "enabled": true},
            {"name": "CNKI (知网)", "keywords": ["拓扑中心计算", "拓扑优先架构", "元拓扑", "化合键", "存算传一体", "物理演化计算", "随机时滞微分方程", "忆阻器网络", "复杂网络涌现智能"], "enabled": true}
        ]
    },

    "sync": {
        "gitee_repo": "https://gitee.com/iBrainNest/i-nest.git",
        "gitee_branch": "main",
        "sync_interval_minutes": 30,
        "auto_pull_on_start": true,
        "auto_push_on_change": true
    }
}
