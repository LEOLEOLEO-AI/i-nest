\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}The Triple Lock and the Thermodynamic Asymptote}{13}{subsection.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Triple Lock mechanism.} Three concentric barriers preventing binary-digital ANN from crossing L1. Outermost ($\alpha $-lock): $\alpha = 0.69$ fixed by binary-digital substrate. Middle ($\Gamma _{st}$-lock): $\Gamma _{st}$ frozen at training. Innermost ($\Psi $-lock): inference-time weight freezing eliminates $\Psi > 0$. Arrows indicate the Gen1$\to $Gen2$\to $Gen3 engineering transitions that sequentially unlock each barrier.}}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:3}{{3}{14}{\textbf {Triple Lock mechanism.} Three concentric barriers preventing binary-digital ANN from crossing L1. Outermost ($\alpha $-lock): $\alpha = 0.69$ fixed by binary-digital substrate. Middle ($\Gst $-lock): $\Gst $ frozen at training. Innermost ($\Psi $-lock): inference-time weight freezing eliminates $\Psi > 0$. Arrows indicate the Gen1$\to $Gen2$\to $Gen3 engineering transitions that sequentially unlock each barrier}{figure.caption.13}{}}
